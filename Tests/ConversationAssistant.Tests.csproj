<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ConversationAssistant.Core.csproj" />
    <Compile Include="..\App\LocalAppProfile.cs" Link="LocalAppProfile.cs" />
    <Compile Include="..\App\UI\AnswerPanelLayout.cs" Link="AnswerPanelLayout.cs" />
    <Compile Include="..\App\UI\AnalysisDocument.cs" Link="AnalysisDocument.cs" />
    <Compile Include="..\App\UI\ConversationHistoryRow.cs" Link="ConversationHistoryRow.cs" />
    <Compile Include="..\App\UI\ProductGuideRow.cs" Link="ProductGuideRow.cs" />
    <Compile Include="..\App\UI\QwenSettingsSave.cs" Link="QwenSettingsSave.cs" />
    <Compile Include="..\App\UI\SuggestedQuestionRow.cs" Link="SuggestedQuestionRow.cs" />
    <Compile Include="..\App\Audio\*.cs" Link="Audio\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\App\MainPage.xaml" Link="MainPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\MainPage.xaml.cs" Link="MainPageCode.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\Themes\TeamsTheme.xaml" Link="TeamsTheme.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\App.xaml" Link="AppResources.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\ConversationAssistant.App.csproj" Link="AppProject.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MeetingCopilot.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestResults\" />
  </ItemGroup>

</Project>
