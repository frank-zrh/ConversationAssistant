<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.2" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.83.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.83.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- Test-only synthesis for optional native-model fixtures; not an app dependency. -->
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ConversationAssistant.Core.csproj" />
    <Compile Include="..\App\UI\AnswerPanelLayout.cs" Link="AnswerPanelLayout.cs" />
    <Compile Include="..\App\UI\AnalysisDocument.cs" Link="AnalysisDocument.cs" />
    <Compile Include="..\App\UI\ConversationHistoryRow.cs" Link="ConversationHistoryRow.cs" />
    <Compile Include="..\App\UI\ProductGuideRow.cs" Link="ProductGuideRow.cs" />
    <Compile Include="..\App\UI\SuggestedQuestionRow.cs" Link="SuggestedQuestionRow.cs" />
    <Compile Include="..\App\Authentication\WorkIqEntraIdentity.cs" Link="WorkIqEntraIdentity.cs" />
    <Compile Include="..\App\Authentication\EntraSignInFlow.cs" Link="EntraSignInFlow.cs" />
    <Compile Include="..\App\Audio\*.cs" Link="Audio\%(Filename)%(Extension)" />
    <Compile Include="..\App\Speech\OfflineSpeaker*.cs" Link="Speech\%(Filename)%(Extension)" />
    <Compile Include="..\App\Speech\OfflineWhisper*.cs" Link="Speech\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MeetingCopilot.Tests.csproj" />
    <None Include="..\App\MainPage.xaml" Link="MainPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\MainPage.xaml.cs" Link="MainPageCode.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\Themes\TeamsTheme.xaml" Link="TeamsTheme.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\App.xaml" Link="AppResources.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\ConversationAssistant.App.csproj" Link="AppProject.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\App.xaml.cs" Link="AppComposition.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App\Properties\PublishProfiles\ClickOnceProfile.pubxml" Link="ClickOnceProfile.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestResults\" />
  </ItemGroup>

</Project>
