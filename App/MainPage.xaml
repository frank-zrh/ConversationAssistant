<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ConversationAssistant_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ConversationAssistant_App.UI"
    Background="{ThemeResource TeamsCanvasBrush}" Foreground="{ThemeResource TeamsTextBrush}"
    FontFamily="Segoe UI Variable" FontSize="14">
    <Page.Resources>
        <ui:QuestionAnswerFontWeightConverter x:Key="QuestionAnswerFontWeightConverter" />
        <DataTemplate x:Key="TranscriptTemplate">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                    Background="{Binding CardBackground}" BorderBrush="{Binding SelectionBorder}"
                    BorderThickness="{Binding SelectionThickness}"
                    AutomationProperties.Name="{Binding AutomationLabel}">
                <StackPanel Spacing="5">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontSize="11"
                                   Foreground="{ThemeResource TeamsSecondaryTextBrush}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="{Binding SpeakerText}" FontSize="12"
                                   Foreground="{ThemeResource TeamsSecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                               Foreground="{ThemeResource TeamsTextBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TranscriptGroupTemplate">
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10"
                      AutomationProperties.Name="{Binding AutomationLabel}"
                      ToolTipService.ToolTip="{Binding Texts[GroupHint]}"
                      RightTapped="Group_RightTapped" KeyDown="Group_KeyDown">
                <Expander.Header>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CountText}" FontSize="12" Opacity=".7" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TranscriptTemplate}" />
            </Expander>
        </DataTemplate>
        <ui:TranscriptTemplateSelector x:Key="TranscriptSelector"
            TranscriptTemplate="{StaticResource TranscriptTemplate}"
            GroupTemplate="{StaticResource TranscriptGroupTemplate}" />
    </Page.Resources>
      <Grid Padding="10" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="PageHeader" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Texts[AppTitle]}" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ListeningText}" FontSize="12" Foreground="{ThemeResource TeamsSecondaryTextBrush}"
                               ToolTipService.ToolTip="{Binding Texts[AudioSharedHint]}" />
                    <TextBlock Text="{Binding TimerText}" FontSize="12" FontFamily="Consolas" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MaxWidth="320">
                <TextBlock Text="{Binding AuthText}" TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="150"
                           VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TeamsSecondaryTextBrush}"
                           ToolTipService.ToolTip="{Binding AuthText}" />
                  <Button x:Name="SignInButton" IsEnabled="{Binding CanSignIn}" Click="SignIn_Click"
                          AutomationProperties.Name="{Binding SignInButtonText}"
                          ToolTipService.ToolTip="{Binding SignInButtonHint}">
                      <Grid>
                          <TextBlock x:Name="SignedInCaption" Text="{Binding SignInButtonText}"
                                     Visibility="{Binding SignedInVisibility}"
                                     Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                          <TextBlock x:Name="SignInCaption" Text="{Binding SignInButtonText}"
                                     Visibility="{Binding SignInVisibility}" />
                      </Grid>
                  </Button>
                  <Button x:Name="SettingsButton" Width="32" Padding="0" Click="Settings_Click"
                          AutomationProperties.Name="{Binding Texts[Settings]}" ToolTipService.ToolTip="{Binding Texts[Settings]}">
                      <FontIcon Glyph="&#xE713;" FontSize="16" />
                  </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ConversationComposer" Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartConversationButton" Style="{StaticResource TeamsPrimaryButtonStyle}"
                    Content="{Binding Texts[StartConversation]}" IsEnabled="{Binding CanStart}" Click="Start_Click" />
            <Button x:Name="EndConversationButton" Grid.Column="1" Width="32" Padding="0"
                    IsEnabled="{Binding CanEnd}" Click="End_Click"
                    AutomationProperties.Name="{Binding Texts[EndConversation]}" ToolTipService.ToolTip="{Binding Texts[EndConversation]}">
                <FontIcon Glyph="&#xE71A;" FontSize="14" />
            </Button>
            <Button x:Name="PauseListeningButton" Grid.Column="2" Width="32" Padding="0"
                    IsEnabled="{Binding CanPause}" Click="Pause_Click"
                    AutomationProperties.Name="{Binding Texts[PauseListening]}" ToolTipService.ToolTip="{Binding Texts[PauseListening]}">
                <FontIcon Glyph="&#xE769;" FontSize="14" />
            </Button>
            <Button x:Name="ResumeListeningButton" Grid.Column="3" Width="32" Padding="0"
                    IsEnabled="{Binding CanResume}" Click="Resume_Click"
                    AutomationProperties.Name="{Binding Texts[Resume]}" ToolTipService.ToolTip="{Binding Texts[Resume]}">
                <FontIcon Glyph="&#xE768;" FontSize="14" />
            </Button>
            <TextBox x:Name="AskBox" Grid.Column="4" PlaceholderText="{Binding Texts[ManualQuestionPlaceholder]}"
                     KeyDown="AskBox_KeyDown" />
            <Button x:Name="SendQuestionButton" Grid.Column="5" Style="{StaticResource TeamsPrimaryButtonStyle}"
                    Content="{Binding Texts[Ask]}" Click="Ask_Click" />
        </Grid>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LastError}"
                   Foreground="{ThemeResource TeamsDangerBrush}" TextWrapping="Wrap" MaxLines="3" />

        <Border Grid.Row="1" Margin="0,0,8,0" CornerRadius="12"
                Background="{ThemeResource TeamsSurfaceBrush}"
                BorderBrush="{ThemeResource TeamsStrokeBrush}" BorderThickness="1">
            <TabView x:Name="TranscriptTabs" IsAddTabButtonVisible="False" CanDragTabs="False"
                     CanReorderTabs="False" TabWidthMode="SizeToContent" SelectedIndex="0"
                     SelectionChanged="TranscriptTabs_SelectionChanged">
                <TabViewItem x:Name="LiveTranscriptTab" Header="{Binding Texts[LiveTranscript]}" IsClosable="False">
                    <Grid Padding="10" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TranscriptToolbar" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RecordStatus}" FontSize="11" Foreground="{ThemeResource TeamsSecondaryTextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding RecordPath}" />
                            <Button Grid.Column="1" Content="{Binding ScrollText}" Click="Scroll_Click" />
                            <DropDownButton x:Name="TranscriptActionsButton" Grid.Column="2" Width="48"
                                            AutomationProperties.Name="{Binding Texts[ConversationActions]}"
                                            ToolTipService.ToolTip="{Binding Texts[ConversationActions]}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout Opening="ActionMenu_Opening">
                                        <MenuFlyoutItem x:Name="NewChatMenuItem" Text="{Binding Texts[NewChat]}"
                                                        IsEnabled="{Binding CanNewChat}" Click="NewChat_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{Binding Texts[CopyTranscript]}" Click="CopyTranscript_Click" />
                                        <MenuFlyoutItem Text="{Binding Texts[ClearTranscript]}" Click="ClearTranscript_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="CreateGroupMenuItem" Text="{Binding Texts[CreateGroup]}"
                                                        IsEnabled="{Binding CanCreateGroup}" Click="CreateGroup_Click" />
                                        <MenuFlyoutItem x:Name="SaveRecordMenuItem" Text="{Binding Texts[SaveNow]}"
                                                        IsEnabled="{Binding CanSaveConversation}" Click="SaveRecord_Click" />
                                        <MenuFlyoutItem x:Name="ViewSessionMenuItem" Text="{Binding Texts[ViewSession]}"
                                                        IsEnabled="{Binding CanViewSession}" Click="ViewSession_Click"
                                                        ToolTipService.ToolTip="{Binding Texts[ViewSessionHint]}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{Binding Texts[OpenRecordsFolder]}" Click="OpenRecordsFolder_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TranscriptList" ItemsSource="{Binding TranscriptListItems}"
                                          ItemTemplateSelector="{StaticResource TranscriptSelector}" />
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Text="{Binding PartialText}" Foreground="{ThemeResource TeamsSecondaryTextBrush}"
                                   TextWrapping="Wrap" FontStyle="Italic" />
                    </Grid>
                </TabViewItem>
                <TabViewItem x:Name="HistoryTab" Header="{Binding Texts[HistoryTitle]}" IsClosable="False">
                    <Grid Padding="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RefreshHistoryButton" Content="{Binding Texts[HistoryRefresh]}"
                                    IsEnabled="{Binding CanRefreshHistory}" Click="RefreshHistory_Click" />
                            <ProgressRing Width="20" Height="20" IsActive="{Binding IsHistoryLoading}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding HistoryStatus}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Grid.Row="2" Text="{Binding Texts[HistoryHint]}" TextWrapping="Wrap"
                                   Opacity=".7" FontSize="12" />
                        <ListView x:Name="ConversationHistoryList" Grid.Row="3"
                                  ItemsSource="{Binding ConversationHistory}" SelectionMode="None"
                                  IsItemClickEnabled="{Binding CanImportConversation}" ItemClick="HistoryRecord_Click"
                                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource TeamsListItemStyle}"
                                  AutomationProperties.Name="{Binding Texts[HistoryTitle]}">
                            <ListView.Header>
                                <Grid x:Name="HistoryColumnsHeader" Margin="8,6" ColumnSpacing="12"
                                      Background="{ThemeResource TeamsSubtleBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="6*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Texts[HistoryColumnStartTime]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Texts[HistoryColumnEndTime]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding Texts[HistoryIntent]}" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="ui:ConversationHistoryRow">
                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{Binding AutomationLabel}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="6*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartTimeText}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TeamsSecondaryTextBrush}"
                                                   ToolTipService.ToolTip="{Binding StartTimeText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding EndTimeText}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TeamsSecondaryTextBrush}"
                                                   ToolTipService.ToolTip="{Binding EndTimeText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding IntentSummary}" TextWrapping="Wrap" MaxLines="3"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding IntentSummary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Border>

        <Grid x:Name="WorkspaceLayout" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding AnalysisPanelHeight}" />
                <RowDefinition Height="{Binding AnswerPanelHeight}" />
            </Grid.RowDefinitions>
            <Border CornerRadius="12"
                    Background="{ThemeResource TeamsSurfaceBrush}"
                    BorderBrush="{ThemeResource TeamsStrokeBrush}" BorderThickness="1">
                <Grid Padding="12" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts[QuestionsHeader]}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="AnalyzeConversationButton" Grid.Column="1" Content="{Binding Texts[AnalyzeConversation]}"
                                ToolTipService.ToolTip="{Binding AnalysisScheduleText}"
                                IsEnabled="{Binding CanAnalyzeConversation}" Click="AnalyzeConversation_Click" />
                    </Grid>
                    <ComboBox x:Name="AnalysisHistoryPicker" Grid.Row="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AnalysisHistory}" DisplayMemberPath="Caption"
                              SelectedItem="{Binding SelectedAnalysis, Mode=TwoWay}"
                              PlaceholderText="{Binding Texts[AnalysisHistory]}"
                              AutomationProperties.Name="{Binding Texts[AnalysisHistory]}"
                              ToolTipService.ToolTip="{Binding Texts[AnalysisHistoryHint]}" />
                    <TabView x:Name="AnalysisTabs" Grid.Row="2" IsAddTabButtonVisible="False"
                             CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" SelectedIndex="0">
                        <TabView.Resources>
                            <x:Double x:Key="TabViewItemMinHeight">36</x:Double>
                            <x:Double x:Key="TabViewItemHeaderFontSize">13</x:Double>
                            <Thickness x:Key="TabViewItemHeaderPadding">10,6,10,6</Thickness>
                            <Thickness x:Key="TabViewSelectedItemHeaderPadding">10,6,10,6</Thickness>
                            <Thickness x:Key="TabViewItemHeaderPaddingWithoutCloseButton">10,6,10,6</Thickness>
                            <Style TargetType="TabViewItem">
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </TabView.Resources>
                        <TabViewItem Header="{Binding Texts[IntentTab]}" IsClosable="False">
                            <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ui:SelectableAnalysisView x:Name="IntentDocument" Sections="{Binding IntentDocumentSections}"
                                                           Foreground="{ThemeResource TeamsTextBrush}"
                                                           AutomationProperties.Name="{Binding Texts[IntentTab]}" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="{Binding Texts[StageSummariesTab]}" IsClosable="False">
                            <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ui:SelectableAnalysisView x:Name="StageSummaryDocument" Sections="{Binding StageDocumentSections}"
                                                           Foreground="{ThemeResource TeamsTextBrush}"
                                                           AutomationProperties.Name="{Binding Texts[StageSummariesTab]}" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="{Binding Texts[RecommendedQuestionsTab]}" IsClosable="False">
                            <Grid Padding="8">
                                <TextBlock Text="{Binding Texts[QuestionsEmpty]}" Visibility="{Binding EmptySuggestionsVisibility}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Opacity=".65" />
                                <ScrollViewer x:Name="SuggestedQuestionsScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SuggestedQuestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Padding="10" Margin="0,0,0,6" CornerRadius="8"
                                                        Background="{ThemeResource TeamsSubtleBrush}" BorderBrush="{ThemeResource TeamsStrokeBrush}"
                                                        AutomationProperties.Name="{Binding AutomationLabel}"
                                                        ToolTipService.ToolTip="{Binding Texts[SuggestedQuestionHint]}"
                                                        Click="SuggestedQuestion_Click" RightTapped="SuggestedQuestion_RightTapped">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                                                   FontWeight="{Binding IsAnswered, Converter={StaticResource QuestionAnswerFontWeightConverter}}"
                                                                   ToolTipService.ToolTip="{Binding Reason}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity=".7" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="{Binding Texts[ProductGuideTab]}" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="8" Spacing="8">
                                    <TextBlock Text="{Binding Texts[ProductGuideHint]}" TextWrapping="Wrap" FontSize="12" Opacity=".7" />
                                    <TextBlock Text="{Binding Texts[ProductGuideEmpty]}" TextWrapping="Wrap" Opacity=".65"
                                               Visibility="{Binding EmptyProductGuidesVisibility}" />
                                    <ItemsControl ItemsSource="{Binding ProductGuides}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          Margin="0,0,0,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Product.Name}">
                                                    <Expander.Header>
                                                        <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <StackPanel Spacing="8">
                                                        <ui:ProductGuideSection Text="{Binding Product.Overview}" />
                                                        <TextBlock Text="{Binding Texts[ProductLicensingHeader]}" FontWeight="SemiBold" />
                                                        <ui:ProductGuideSection Text="{Binding Product.LicensingAndPricing}" />
                                                        <TextBlock Text="{Binding Texts[ProductScenariosHeader]}" FontWeight="SemiBold" />
                                                        <ui:ProductGuideSection Text="{Binding Product.SuitableScenarios}" />
                                                        <TextBlock Text="{Binding Texts[ProductLimitationsHeader]}" FontWeight="SemiBold" />
                                                        <ui:ProductGuideSection Text="{Binding Product.Limitations}" />
                                                        <ui:ProductGuideSection Text="{Binding AdditionalNotesText}" />
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PendingAnalysisText}" FontSize="12" Opacity=".7"
                                   ToolTipService.ToolTip="{Binding AnalysisScheduleText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AnalysisStatus}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding AnalysisStatus}" />
                    </Grid>
                    <TextBlock Grid.Row="4" Text="{Binding AnalysisError}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TeamsDangerBrush}" MaxLines="3" />
                </Grid>
            </Border>
        <Border Grid.Row="1" CornerRadius="12"
                Background="{ThemeResource TeamsSurfaceBrush}"
                BorderBrush="{ThemeResource TeamsStrokeBrush}" BorderThickness="1">
            <Grid x:Name="AssistantLayout" Padding="12" RowSpacing="{Binding AnswerPanelRowSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AnswerPanelToggleButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="{Binding AnswerPanelToggleText}"
                            AutomationProperties.HelpText="{Binding Texts[AnswerPanelToggleHint]}"
                            ToolTipService.ToolTip="{Binding AnswerPanelToggleText}" Click="ToggleAnswerPanel_Click"
                            RightTapped="AnswerPanelToggle_RightTapped">
                        <FontIcon Glyph="{Binding AnswerPanelToggleGlyph}" FontSize="16" />
                    </Button>
                    <DropDownButton x:Name="AnswerActionsButton" Grid.Column="1" Width="48"
                                    Visibility="{Binding AnswerPanelVisibility}"
                                    AutomationProperties.Name="{Binding Texts[AnswerActions]}"
                                    ToolTipService.ToolTip="{Binding Texts[AnswerActions]}">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Opening="ActionMenu_Opening">
                                <MenuFlyoutItem Text="{Binding Texts[CopyAnswer]}" Click="CopyAnswer_Click" />
                                <MenuFlyoutItem Text="{Binding Texts[Retry]}" Click="Retry_Click" />
                                <MenuFlyoutItem Text="{Binding Texts[Dismiss]}" Click="Dismiss_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="AnswerViewMenuItem" Text="{Binding Texts[ViewOriginal]}" Click="AnswerView_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <ComboBox x:Name="AnswerHistoryPicker" Grid.Row="1" Visibility="{Binding AnswerPanelVisibility}"
                          AutomationProperties.Name="{Binding Texts[AnswersHeader]}" ItemsSource="{Binding Answers}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding Texts[SelectQuestion]}"
                          SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Question}" MaxWidth="330"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid x:Name="AnswerContent" Grid.Row="2" RowSpacing="6" Visibility="{Binding AnswerPanelVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedAnswer.StatusText}" Opacity=".7" />
                        <TextBlock x:Name="AnswerRenderStatus" TextWrapping="Wrap" Opacity=".7"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <ScrollViewer x:Name="AnswerFallback" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="AnswerFallbackText" Text="{Binding Texts[AnswerSelect]}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <WebView2 x:Name="AnswerWebView" Grid.Row="1" Opacity="0"
                              IsHitTestVisible="False" />
                    <TextBlock Grid.Row="2" Text="{Binding SelectedAnswer.Error}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TeamsDangerBrush}" />
                </Grid>
                <Grid.Resources>
                    <Flyout x:Key="SettingsFlyout">
                    <ScrollViewer MaxHeight="380" Width="360">
                        <StackPanel Spacing="12" Padding="4,10">
                            <Grid RowSpacing="6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Texts[ListeningLanguage]}" VerticalAlignment="Center" />
                                <ComboBox x:Name="LanguagePicker" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding SpeechLanguageOptions}" DisplayMemberPath="Label"
                                          SelectedIndex="{Binding SpeechLanguageIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChangeSpeechLanguage}"
                                          AutomationProperties.Name="{Binding Texts[ListeningLanguage]}"
                                          ToolTipService.ToolTip="{Binding Texts[LanguageHint]}" />
                                <TextBlock Grid.Row="1" Text="{Binding Texts[AnalysisLanguage]}" VerticalAlignment="Center" />
                                <ComboBox x:Name="AnalysisLanguagePicker" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AnalysisLanguageOptions}" DisplayMemberPath="Label"
                                          SelectedIndex="{Binding AnalysisLanguageIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Texts[AnalysisLanguage]}"
                                          ToolTipService.ToolTip="{Binding Texts[AnalysisLanguageHint]}" />
                                <TextBlock Grid.Row="2" Text="{Binding Texts[DisplayLanguage]}" VerticalAlignment="Center" />
                                <ComboBox x:Name="DisplayLanguagePicker" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding DisplayLanguageOptions}" DisplayMemberPath="Label"
                                          SelectedIndex="{Binding DisplayLanguageIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Texts[DisplayLanguage]}"
                                          ToolTipService.ToolTip="{Binding Texts[DisplayLanguageHint]}" />
                            </Grid>
                            <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Texts[SpeakerAccuracyHint]}" TextWrapping="Wrap" Opacity=".7" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Texts[SpeechSection]}" FontWeight="SemiBold" />
                                <ComboBox Header="{Binding Texts[SpeechProvider]}" HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding CanEditSpeechSettings}"
                                          ItemsSource="{Binding SpeechProviderOptions}" DisplayMemberPath="Label"
                                          SelectedIndex="{Binding SpeechProviderIndex, Mode=TwoWay}" />
                                <TextBox Header="{Binding Texts[Endpoint]}"
                                         IsEnabled="{Binding CanEditSpeechSettings}"
                                         Text="{Binding SpeechServiceUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="https://your-resource.cognitiveservices.azure.com/"
                                         InputScope="Url" />
                                <TextBlock Text="{Binding SpeechEndpointPreview}" TextWrapping="Wrap" Opacity=".7" />
                                <TextBlock Text="{Binding Texts[AuthenticationMethod]}"
                                           TextWrapping="Wrap" />
                                <TextBox Header="{Binding Texts[TenantId]}"
                                             IsEnabled="{Binding CanEditSpeechSettings}"
                                             Text="{Binding SpeechTenantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{Binding Texts[TenantPlaceholder]}" />
                                 <TextBlock Text="{Binding Texts[TenantHelp]}"
                                            TextWrapping="Wrap" Opacity=".7" />
                                <TextBox Header="{Binding Texts[ClientId]}"
                                             IsEnabled="{Binding CanEditSpeechSettings}"
                                             Text="{Binding SpeechClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{Binding Texts[ClientPlaceholder]}" />
                                <TextBlock Text="{Binding Texts[ClientHelp]}"
                                           TextWrapping="Wrap" Opacity=".7" />
                                <CheckBox IsChecked="{Binding CloudAudioConsent, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEditSpeechSettings}">
                                    <TextBlock Text="{Binding Texts[AudioConsent]}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="{Binding Texts[SaveSpeechSettings]}" Click="SaveSpeechSettings_Click"
                                        IsEnabled="{Binding CanEditSpeechSettings}" />
                                <Button Content="{Binding SpeechConnectionButtonText}" Click="TestSpeechConnection_Click"
                                        IsEnabled="{Binding CanEditSpeechSettings}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SpeechSettingsStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Texts[IdentityHelp]}"
                                       TextWrapping="Wrap" Opacity=".7" />
                            <Button Content="{Binding Texts[MicrophonePrivacy]}" Click="MicSettings_Click"
                                    HorizontalAlignment="Left" />
                            <ComboBox x:Name="AudioModePicker" Header="{Binding Texts[AudioSource]}"
                                      HorizontalAlignment="Stretch" ItemsSource="{Binding AudioModeOptions}"
                                      DisplayMemberPath="Label" SelectedIndex="{Binding AudioModeIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeAudioSettings}" />
                            <TextBlock Text="{Binding Texts[AudioSharedHint]}" TextWrapping="Wrap" Opacity=".7" />
                            <TextBlock Text="{Binding Texts[SystemAudioNotice]}" TextWrapping="Wrap"
                                       Visibility="{Binding SystemAudioNoticeVisibility}" />
                            <TextBlock Text="{Binding Texts[InputDevice]}" />
                            <ComboBox x:Name="InputDevicePicker" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChooseInputDevice}" />
                            <TextBlock Text="{Binding Texts[OutputDevice]}" />
                            <ComboBox x:Name="OutputDevicePicker" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChooseOutputDevice}" />
                            <Button Content="{Binding Texts[RefreshDevices]}" Click="RefreshDevices_Click"
                                    IsEnabled="{Binding CanChangeAudioSettings}" />
                            <TextBlock Text="{Binding Texts[ContextWindow]}" />
                            <ComboBox x:Name="ContextPicker" ItemsSource="{Binding ContextOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{Binding ContextWindowIndex, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Texts[AnswerStyle]}" />
                            <ComboBox x:Name="StylePicker" ItemsSource="{Binding AnswerStyleOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{Binding AnswerStyleIndex, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Texts[GroundingNote]}"
                                       TextWrapping="Wrap" />
                            <ToggleSwitch Header="{Binding Texts[StoreAudio]}" IsOn="False" IsEnabled="False"
                                          OnContent="{Binding Texts[On]}" OffContent="{Binding Texts[Off]}" />
                            <ToggleSwitch Header="{Binding Texts[StoreTranscript]}" IsOn="True" IsEnabled="False"
                                          OnContent="{Binding Texts[On]}" OffContent="{Binding Texts[Off]}" />
                            <ToggleSwitch Header="{Binding Texts[ClearAfterConversation]}" IsOn="False" IsEnabled="False"
                                          OnContent="{Binding Texts[On]}" OffContent="{Binding Texts[Off]}" />
                            <TextBlock Text="{Binding Texts[RecordPrivacy]}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Texts[SessionLogPrivacy]}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RecordPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <Button Content="{Binding Texts[OpenRecordsFolder]}" Click="OpenRecordsFolder_Click" />
                        </StackPanel>
                    </ScrollViewer>
                    </Flyout>
                </Grid.Resources>
            </Grid>
        </Border>
        </Grid>

      </Grid>
</Page>
