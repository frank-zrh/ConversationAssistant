<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ConversationAssistant_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <Style x:Key="TranscriptCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
      <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding Texts[AppTitle]}" FontSize="24" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ListeningText}" Opacity=".7"
                               ToolTipService.ToolTip="{Binding Texts[AudioSharedHint]}" />
                    <TextBlock Text="{Binding TimerText}" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Texts[ListeningLanguage]}" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguagePicker" Width="175"
                              ItemsSource="{Binding SpeechLanguageOptions}" DisplayMemberPath="Label"
                              SelectedIndex="{Binding SpeechLanguageIndex, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeSpeechLanguage}"
                              AutomationProperties.Name="{Binding Texts[ListeningLanguage]}"
                              ToolTipService.ToolTip="{Binding Texts[LanguageHint]}" />
                    <ToggleSwitch AutomationProperties.Name="{Binding Texts[AutoAnalysis]}"
                                  OnContent="{Binding Texts[AutoAnalysisOn]}" OffContent="{Binding Texts[AutoAnalysisOff]}"
                                  ToolTipService.ToolTip="{Binding Texts[AutoAnalysisHint]}"
                                  IsOn="{Binding AutomaticAnalysis, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MaxWidth="320">
                <TextBlock Text="{Binding AuthText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="SignInButton" IsEnabled="{Binding CanSignIn}" Click="SignIn_Click"
                          AutomationProperties.Name="{Binding SignInButtonText}"
                          ToolTipService.ToolTip="{Binding SignInButtonHint}">
                      <Grid>
                          <TextBlock x:Name="SignedInCaption" Text="{Binding SignInButtonText}"
                                     Visibility="{Binding SignedInVisibility}"
                                     Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                          <TextBlock x:Name="SignInCaption" Text="{Binding SignInButtonText}"
                                     Visibility="{Binding SignInVisibility}" />
                      </Grid>
                  </Button>
                  <Button Content="{Binding Texts[Settings]}" Click="Settings_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{Binding Texts[StartConversation]}" IsEnabled="{Binding CanStart}" Click="Start_Click" />
            <Button Grid.Column="1" Content="{Binding Texts[EndConversation]}" IsEnabled="{Binding CanEnd}" Click="End_Click" />
            <Button Grid.Column="2" Content="{Binding Texts[PauseListening]}" IsEnabled="{Binding CanPause}" Click="Pause_Click" />
            <Button Grid.Column="3" Content="{Binding Texts[Resume]}" IsEnabled="{Binding CanResume}" Click="Resume_Click" />
            <TextBox x:Name="AskBox" Grid.Column="4" PlaceholderText="{Binding Texts[ManualQuestionPlaceholder]}"
                     KeyDown="AskBox_KeyDown" />
            <Button Grid.Column="5" Content="{Binding Texts[Ask]}" Click="Ask_Click" />
        </Grid>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LastError}"
                   Foreground="IndianRed" TextWrapping="Wrap" MaxLines="3" />

        <Border Grid.Row="1" Margin="0,0,8,0" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid Padding="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Texts[LiveTranscript]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Texts[CopyTranscript]}" Click="CopyTranscript_Click" />
                    <Button Grid.Column="2" Content="{Binding Texts[ClearTranscript]}" Click="ClearTranscript_Click" />
                    <Button Grid.Column="3" Content="{Binding ScrollText}" Click="Scroll_Click" />
                </Grid>
                <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TranscriptItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TranscriptCardStyle}"
                                        Margin="0,0,0,10"
                                        Background="{Binding CardBackground}"
                                        BorderBrush="{Binding SelectionBorder}"
                                        BorderThickness="{Binding SelectionThickness}"
                                        AutomationProperties.Name="{Binding AutomationLabel}"
                                        AutomationProperties.HelpText="{Binding Texts[TranscriptCardHint]}"
                                        ToolTipService.ToolTip="{Binding Texts[TranscriptCardHint]}"
                                        Click="TranscriptCard_Click"
                                        RightTapped="TranscriptCard_RightTapped">
                                    <StackPanel Spacing="7">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Opacity=".75" FontSize="12"
                                                       Foreground="#1F2937" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="1" Text="{Binding SpeakerText}" FontSize="12"
                                                       Foreground="#1F2937" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                                       Foreground="#374151" HorizontalAlignment="Right"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"
                                                   Foreground="#1F2937" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding PartialText}" Opacity=".65"
                           TextWrapping="Wrap" FontStyle="Italic" />
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceLayout" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid Padding="12" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts[QuestionsHeader]}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="AnalyzeConversationButton" Grid.Column="1" Content="{Binding Texts[AnalyzeConversation]}"
                                ToolTipService.ToolTip="{Binding AnalysisScheduleText}"
                                IsEnabled="{Binding CanAnalyzeConversation}" Click="AnalyzeConversation_Click" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PendingAnalysisText}" FontSize="12" Opacity=".7"
                                   ToolTipService.ToolTip="{Binding AnalysisScheduleText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AnalysisStatus}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding AnalysisStatus}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Texts[QuestionsEmpty]}"
                               Visibility="{Binding EmptySuggestionsVisibility}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Opacity=".65" />
                    <ScrollViewer x:Name="SuggestedQuestionsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SuggestedQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="10" Margin="0,0,0,6" CornerRadius="8"
                                            AutomationProperties.Name="{Binding AutomationLabel}"
                                            ToolTipService.ToolTip="{Binding Texts[SuggestedQuestionHint]}"
                                            Click="SuggestedQuestion_Click">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Opacity=".8" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity=".7" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="3" Text="{Binding AnalysisError}" TextWrapping="Wrap"
                               Foreground="IndianRed" MaxLines="3" />
                </Grid>
            </Border>
        <Border Grid.Row="1" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid x:Name="AssistantLayout" Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="AnswerHistoryPicker" Header="{Binding Texts[AnswersHeader]}" ItemsSource="{Binding Answers}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding Texts[SelectQuestion]}"
                          SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Question}" MaxWidth="330"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="{Binding Texts[CopyAnswer]}" Click="CopyAnswer_Click" />
                    <Button Content="{Binding Texts[Retry]}" Click="Retry_Click" />
                    <Button Content="{Binding Texts[Dismiss]}" Click="Dismiss_Click" />
                    <Button x:Name="AnswerViewButton" Content="{Binding Texts[ViewOriginal]}" Click="AnswerView_Click" />
                </StackPanel>
                <Grid Grid.Row="1" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedAnswer.StatusText}" Opacity=".7" />
                        <TextBlock x:Name="AnswerRenderStatus" TextWrapping="Wrap" Opacity=".7"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <ScrollViewer x:Name="AnswerFallback" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="AnswerFallbackText" Text="{Binding Texts[AnswerSelect]}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <WebView2 x:Name="AnswerWebView" Grid.Row="1" Opacity="0"
                              IsHitTestVisible="False" />
                    <TextBlock Grid.Row="2" Text="{Binding SelectedAnswer.Error}" TextWrapping="Wrap"
                               Foreground="IndianRed" />
                </Grid>
                <Grid.Resources>
                    <Flyout x:Key="SettingsFlyout">
                    <ScrollViewer MaxHeight="380" Width="360">
                        <StackPanel Spacing="12" Padding="4,10">
                            <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Texts[SpeakerAccuracyHint]}" TextWrapping="Wrap" Opacity=".7" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Texts[SpeechSection]}" FontWeight="SemiBold" />
                                <ComboBox Header="{Binding Texts[SpeechProvider]}" HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding CanEditSpeechSettings}"
                                          ItemsSource="{Binding SpeechProviderOptions}" DisplayMemberPath="Label"
                                          SelectedIndex="{Binding SpeechProviderIndex, Mode=TwoWay}" />
                                <TextBox Header="{Binding Texts[Endpoint]}"
                                         IsEnabled="{Binding CanEditSpeechSettings}"
                                         Text="{Binding SpeechServiceUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="https://your-resource.cognitiveservices.azure.com/"
                                         InputScope="Url" />
                                <TextBlock Text="{Binding SpeechEndpointPreview}" TextWrapping="Wrap" Opacity=".7" />
                                <TextBlock Text="{Binding Texts[AuthenticationMethod]}"
                                           TextWrapping="Wrap" />
                                <TextBox Header="{Binding Texts[TenantId]}"
                                             IsEnabled="{Binding CanEditSpeechSettings}"
                                             Text="{Binding SpeechTenantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{Binding Texts[TenantPlaceholder]}" />
                                 <TextBlock Text="{Binding Texts[TenantHelp]}"
                                            TextWrapping="Wrap" Opacity=".7" />
                                <TextBox Header="{Binding Texts[ClientId]}"
                                             IsEnabled="{Binding CanEditSpeechSettings}"
                                             Text="{Binding SpeechClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{Binding Texts[ClientPlaceholder]}" />
                                <TextBlock Text="{Binding Texts[ClientHelp]}"
                                           TextWrapping="Wrap" Opacity=".7" />
                                <CheckBox IsChecked="{Binding CloudAudioConsent, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEditSpeechSettings}">
                                    <TextBlock Text="{Binding Texts[AudioConsent]}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="{Binding Texts[SaveSpeechSettings]}" Click="SaveSpeechSettings_Click"
                                        IsEnabled="{Binding CanEditSpeechSettings}" />
                                <Button Content="{Binding SpeechConnectionButtonText}" Click="TestSpeechConnection_Click"
                                        IsEnabled="{Binding CanEditSpeechSettings}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SpeechSettingsStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Texts[IdentityHelp]}"
                                       TextWrapping="Wrap" Opacity=".7" />
                            <Button Content="{Binding Texts[MicrophonePrivacy]}" Click="MicSettings_Click"
                                    HorizontalAlignment="Left" />
                            <ComboBox x:Name="AudioModePicker" Header="{Binding Texts[AudioSource]}"
                                      HorizontalAlignment="Stretch" ItemsSource="{Binding AudioModeOptions}"
                                      DisplayMemberPath="Label" SelectedIndex="{Binding AudioModeIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeAudioSettings}" />
                            <TextBlock Text="{Binding Texts[AudioSharedHint]}" TextWrapping="Wrap" Opacity=".7" />
                            <TextBlock Text="{Binding Texts[SystemAudioNotice]}" TextWrapping="Wrap"
                                       Visibility="{Binding SystemAudioNoticeVisibility}" />
                            <TextBlock Text="{Binding Texts[InputDevice]}" />
                            <ComboBox x:Name="InputDevicePicker" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChooseInputDevice}" />
                            <TextBlock Text="{Binding Texts[OutputDevice]}" />
                            <ComboBox x:Name="OutputDevicePicker" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChooseOutputDevice}" />
                            <Button Content="{Binding Texts[RefreshDevices]}" Click="RefreshDevices_Click"
                                    IsEnabled="{Binding CanChangeAudioSettings}" />
                            <TextBlock Text="{Binding Texts[ContextWindow]}" />
                            <ComboBox x:Name="ContextPicker" ItemsSource="{Binding ContextOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{Binding ContextWindowIndex, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Texts[AnswerStyle]}" />
                            <ComboBox x:Name="StylePicker" ItemsSource="{Binding AnswerStyleOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{Binding AnswerStyleIndex, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Texts[AnswerLanguage]}" />
                            <ComboBox x:Name="AnswerLanguagePicker" ItemsSource="{Binding AnswerLanguageOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{Binding AnswerLanguageIndex, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Texts[GroundingNote]}"
                                       TextWrapping="Wrap" />
                            <ToggleSwitch Header="{Binding Texts[StoreAudio]}" IsOn="False" IsEnabled="False"
                                          OnContent="{Binding Texts[On]}" OffContent="{Binding Texts[Off]}" />
                            <ToggleSwitch Header="{Binding Texts[StoreTranscript]}" IsOn="False" IsEnabled="False"
                                          OnContent="{Binding Texts[On]}" OffContent="{Binding Texts[Off]}" />
                            <ToggleSwitch Header="{Binding Texts[ClearAfterConversation]}" IsOn="True" IsEnabled="False"
                                          OnContent="{Binding Texts[On]}" OffContent="{Binding Texts[Off]}" />
                        </StackPanel>
                    </ScrollViewer>
                    </Flyout>
                </Grid.Resources>
            </Grid>
        </Border>
        </Grid>

      </Grid>
</Page>
