<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TeamsCanvasBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="TeamsSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TeamsSubtleBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TeamsTextBrush" Color="#242424" />
            <SolidColorBrush x:Key="TeamsSecondaryTextBrush" Color="#616161" />
            <SolidColorBrush x:Key="TeamsStrokeBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="TeamsAccentBrush" Color="#5B5FC7" />
            <SolidColorBrush x:Key="TeamsOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TeamsDangerBrush" Color="#B10E1E" />
            <SolidColorBrush x:Key="TeamsSuccessBrush" Color="#107C41" />
            <SolidColorBrush x:Key="TeamsPendingBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="TeamsCompletedBrush" Color="#E7F4EA" />
            <SolidColorBrush x:Key="TeamsFailedBrush" Color="#FCE8E6" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#5B5FC7" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4F52B2" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#444791" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TeamsCanvasBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="TeamsSurfaceBrush" Color="#292929" />
            <SolidColorBrush x:Key="TeamsSubtleBrush" Color="#333333" />
            <SolidColorBrush x:Key="TeamsTextBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="TeamsSecondaryTextBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="TeamsStrokeBrush" Color="#474747" />
            <SolidColorBrush x:Key="TeamsAccentBrush" Color="#A6A7DC" />
            <SolidColorBrush x:Key="TeamsOnAccentBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="TeamsDangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="TeamsSuccessBrush" Color="#6CCB8E" />
            <SolidColorBrush x:Key="TeamsPendingBrush" Color="#433B20" />
            <SolidColorBrush x:Key="TeamsCompletedBrush" Color="#203A2A" />
            <SolidColorBrush x:Key="TeamsFailedBrush" Color="#452A2A" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#A6A7DC" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B9BAEA" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#9698CF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1F1F1F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TeamsCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TeamsSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TeamsSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TeamsTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TeamsSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TeamsStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TeamsAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TeamsOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TeamsDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TeamsSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TeamsPendingBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TeamsCompletedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TeamsFailedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="TabViewItemMinHeight">36</x:Double>
    <x:Double x:Key="TabViewItemHeaderFontSize">13</x:Double>
    <Thickness x:Key="TabViewItemHeaderPadding">10,6,10,6</Thickness>
    <Thickness x:Key="TabViewSelectedItemHeaderPadding">10,6,10,6</Thickness>
    <Thickness x:Key="TabViewItemHeaderPaddingWithoutCloseButton">10,6,10,6</Thickness>

    <Style x:Key="TeamsButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource TeamsButtonStyle}" />
    <Style x:Key="TeamsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{ThemeResource TeamsAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TeamsOnAccentBrush}" />
    </Style>
    <Style TargetType="DropDownButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="TeamsListItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{ThemeResource TeamsTextBrush}" />
    </Style>
</ResourceDictionary>
